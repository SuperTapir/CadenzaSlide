  "slides": {
    "opening": {
      "id": "opening",
      "role": "intro",
      "layout": "title",
      "label": "Compose With Intent",
      "ariaLabel": "Compose With Intent",
      "title": ["Compose With Intent"],
      "subtitle": "Presentations should be composed, not filled in",
      "meta": "CADENZA / ENGLISH DEMO",
      "notes": "Narrative role: Establish the thesis and the standard for the story\nEvidence: CadenzaSlide product mission"
    },
    "template-problem": {
      "id": "template-problem",
      "role": "content",
      "layout": "title-bullets",
      "label": "The Template Problem",
      "ariaLabel": "Templates preserve consistency and repeat the same answer",
      "title": ["Consistency Is Not", "The Same as Repetition"],
      "subtitle": "A fixed page structure keeps reusing yesterday’s answer",
      "body": "When the content changes, the visual reasoning must change with it",
      "items": [
        "The claim changes",
        "The evidence changes",
        "The relationship must change"
      ],
      "notes": "Narrative role: Define the failure mode that Cadenza addresses\nEvidence: Existing Cadenza demo problem statement"
    },
    "system-thesis": {
      "id": "system-thesis",
      "role": "content",
      "layout": "statement",
      "label": "System Thesis",
      "ariaLabel": "From content signals to visual relationships",
      "title": ["Read the Content", "Before Choosing the Form"],
      "subtitle": "Claims, evidence, order, and media should determine the composition",
      "notes": "Narrative role: Introduce the system-level answer\nEvidence: cadenza-presentations authoring workflow"
    },
    "three-layers": {
      "id": "three-layers",
      "role": "content",
      "layout": "agenda",
      "label": "Three Layers",
      "ariaLabel": "Structure content and relationship form the production language",
      "title": ["Three Layers,", "One Visual Language"],
      "subtitle": "A small set of primitives produces many narrative shapes",
      "items": [
        { "number": "01", "title": "Structure sets the reading order" },
        { "number": "02", "title": "Content carries the evidence" },
        { "number": "03", "title": "Relationship explains the meaning" }
      ],
      "notes": "Narrative role: Explain the smallest reusable building blocks\nEvidence: 6 layout + 10 content + 3 relationship primitives in the production registry"
    },
    "composition-grammar": {
      "id": "composition-grammar",
      "role": "content",
      "layout": "quote",
      "label": "Composition Grammar",
      "ariaLabel": "A grammar not a gallery",
      "quote": "A grammar creates new sentences. A gallery only repeats examples.",
      "attribution": "Cadenza",
      "source": "Composition Principle / 01",
      "notes": "Narrative role: Differentiate Cadenza from a template or component gallery\nEvidence: Production component registry and authoring constraints"
    },
    "master-system": {
      "id": "master-system",
      "role": "content",
      "layout": "statement",
      "label": "Deck Master",
      "ariaLabel": "The master protects the voice",
      "title": ["The Master", "Protects the Voice"],
      "subtitle": "Typography, environments, safe boundaries, and motion give every slide the same visual DNA",
      "notes": "Narrative role: Show where consistency comes from\nEvidence: Deck Master layout and token contracts"
    },
    "composer": {
      "id": "composer",
      "role": "content",
      "layout": "agenda",
      "label": "Composer",
      "ariaLabel": "Generate candidates and reject invalid ones",
      "title": ["Compose by", "Testing Candidates"],
      "subtitle": "Generation is useful only when rejection is equally strong",
      "items": [
        { "number": "01", "title": "Generate from content signals" },
        { "number": "02", "title": "Reject semantic and capacity failures" },
        { "number": "03", "title": "Rank the compositions that remain" }
      ],
      "notes": "Narrative role: Explain generation without implying unconstrained AI layout\nEvidence: Composer preflight and candidate pipeline"
    },
    "verifier": {
      "id": "verifier",
      "role": "content",
      "layout": "big-fact",
      "label": "Verifier",
      "ariaLabel": "Quality is a contract",
      "value": "PASS",
      "factLabel": "Quality is a contract: readable, aligned, unclipped, and faithful to the evidence",
      "notes": "Narrative role: Establish engineering credibility\nEvidence: Static verifier and browser geometry rules"
    },
    "human-loop": {
      "id": "human-loop",
      "role": "content",
      "layout": "quote",
      "label": "Human Review",
      "ariaLabel": "Agents build and humans review the story",
      "quote": "Agents build the deck. Humans judge whether the story works.",
      "attribution": "Cadenza",
      "source": "Review Principle / 01",
      "notes": "Narrative role: Define the collaboration boundary\nEvidence: Studio, Overview, and Audience review workflow"
    },
    "workflow": {
      "id": "workflow",
      "role": "content",
      "layout": "agenda",
      "label": "Workflow",
      "ariaLabel": "Brief outline build verify",
      "title": ["A Workflow With", "Explicit Checkpoints"],
      "subtitle": "Every deck earns its way to presentation",
      "items": [
        { "number": "01", "title": "Brief" },
        { "number": "02", "title": "Outline" },
        { "number": "03", "title": "Build" },
        { "number": "04", "title": "Verify" }
      ],
      "notes": "Narrative role: Make the operating model concrete\nEvidence: cadenza-presentations creation workflow"
    },
    "studio-proof": {
      "id": "studio-proof",
      "role": "content",
      "layout": "big-fact",
      "label": "Studio Proof",
      "ariaLabel": "A real workspace not a render export",
      "value": "1",
      "factLabel": "document from Studio to Overview, Audience, notes, Agent edits, and verification",
      "notes": "Narrative role: Prove that the workflow exists in the product\nEvidence: Live CadenzaSlide Studio capture"
    },
    "cross-content-proof": {
      "id": "cross-content-proof",
      "role": "content",
      "layout": "title-bullets",
      "label": "Cross-content Proof",
      "ariaLabel": "One system supports different narrative shapes",
      "title": ["One System,", "Different Narrative Shapes"],
      "subtitle": "The same contracts adapt to very different kinds of explanation",
      "body": "The system should generalize beyond one polished demo",
      "items": ["Summaries and comparisons", "Steps, timelines, and systems", "People, quotations, and media"],
      "notes": "Narrative role: Demonstrate reuse beyond one polished demo\nEvidence: Composition evaluation corpus"
    },
    "open-source": {
      "id": "open-source",
      "role": "content",
      "layout": "statement",
      "label": "Open Source",
      "ariaLabel": "Inspectable by design",
      "title": ["Open Source Means", "Inspectable Decisions"],
      "subtitle": "The Skill, JSON contracts, renderer, and verifier can all be audited and extended",
      "notes": "Narrative role: Connect the architecture to the open-source proposition\nEvidence: Public repository structure and MIT license"
    },
    "closing": {
      "id": "closing",
      "role": "content",
      "layout": "statement",
      "label": "Closing",
      "ariaLabel": "Start with intent and end with evidence",
      "title": ["Start With Intent", "End With Evidence"],
      "subtitle": "Make presentations that are beautiful, explainable, and verifiable",
      "notes": "Narrative role: Close with the product promise and call to action\nEvidence: Cadenza CLI and GitHub repository"
