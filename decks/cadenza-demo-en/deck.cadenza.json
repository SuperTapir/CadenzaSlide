  "slides": {
    "opening": {
      "id": "opening",
      "role": "intro",
      "layout": "title",
      "label": "Compose With Intent",
      "ariaLabel": "Compose With Intent",
      "title": ["Compose With Intent"],
      "subtitle": "Presentations should be composed, not filled in",
      "meta": "CADENZA / ENGLISH DEMO OUTLINE",
      "notes": "Narrative role: Establish the thesis and the standard for the story\nEvidence: CadenzaSlide product mission"
    },
    "template-problem": {
      "id": "template-problem",
      "role": "content",
      "layout": "title-only",
      "label": "The Template Problem",
      "ariaLabel": "Templates preserve consistency and repeat the same answer",
      "title": ["Templates Preserve Consistency—and Repeat the Same Answer"],
      "subtitle": "When the content changes, a fixed page structure cannot change its reasoning",
      "notes": "Narrative role: Define the failure mode that Cadenza addresses\nEvidence: Existing Cadenza demo problem statement"
    },
    "system-thesis": {
      "id": "system-thesis",
      "role": "content",
      "layout": "statement",
      "label": "System Thesis",
      "ariaLabel": "From content signals to visual relationships",
      "title": ["From Content Signals to Visual Relationships"],
      "subtitle": "Understand claims, evidence, order, and media before choosing form",
      "notes": "Narrative role: Introduce the system-level answer\nEvidence: cadenza-presentations authoring workflow"
    },
    "three-layers": {
      "id": "three-layers",
      "role": "content",
      "layout": "title-only",
      "label": "Three Layers",
      "ariaLabel": "Structure content and relationship form the production language",
      "title": ["Structure / Content / Relationship"],
      "subtitle": "Nineteen production primitives form one controlled language",
      "notes": "Narrative role: Explain the smallest reusable building blocks\nEvidence: 6 layout + 10 content + 3 relationship primitives in the production registry"
    },
    "composition-grammar": {
      "id": "composition-grammar",
      "role": "content",
      "layout": "title-only",
      "label": "Composition Grammar",
      "ariaLabel": "A grammar not a gallery",
      "title": ["A Grammar, Not a Gallery"],
      "subtitle": "Components combine around real semantics instead of visual preference",
      "notes": "Narrative role: Differentiate Cadenza from a template or component gallery\nEvidence: Production component registry and authoring constraints"
    },
    "master-system": {
      "id": "master-system",
      "role": "content",
      "layout": "title-only",
      "label": "Deck Master",
      "ariaLabel": "The master protects the voice",
      "title": ["The Master Protects the Voice"],
      "subtitle": "Typography, environments, regions, and safe boundaries stay coherent across the deck",
      "notes": "Narrative role: Show where consistency comes from\nEvidence: Deck Master layout and token contracts"
    },
    "composer": {
      "id": "composer",
      "role": "content",
      "layout": "title-only",
      "label": "Composer",
      "ariaLabel": "Generate candidates and reject invalid ones",
      "title": ["Generate Candidates / Reject Invalid Ones"],
      "subtitle": "Only compositions that pass hard semantic and capacity constraints can be ranked",
      "notes": "Narrative role: Explain generation without implying unconstrained AI layout\nEvidence: Composer preflight and candidate pipeline"
    },
    "verifier": {
      "id": "verifier",
      "role": "content",
      "layout": "statement",
      "label": "Verifier",
      "ariaLabel": "Quality is a contract",
      "title": ["Quality Is a Contract"],
      "subtitle": "Readability, coverage, alignment, clipping, and evidence fidelity are testable",
      "notes": "Narrative role: Establish engineering credibility\nEvidence: Static verifier and browser geometry rules"
    },
    "human-loop": {
      "id": "human-loop",
      "role": "content",
      "layout": "title-only",
      "label": "Human Review",
      "ariaLabel": "Agents build and humans review the story",
      "title": ["Agents Build / Humans Review the Story"],
      "subtitle": "Overview reveals narrative rhythm; Audience decides whether the full-size page is finished",
      "notes": "Narrative role: Define the collaboration boundary\nEvidence: Studio, Overview, and Audience review workflow"
    },
    "workflow": {
      "id": "workflow",
      "role": "content",
      "layout": "title-only",
      "label": "Workflow",
      "ariaLabel": "Brief outline build verify",
      "title": ["Brief → Outline → Build → Verify"],
      "subtitle": "Every new deck passes explicit review checkpoints before presentation",
      "notes": "Narrative role: Make the operating model concrete\nEvidence: cadenza-presentations creation workflow"
    },
    "studio-proof": {
      "id": "studio-proof",
      "role": "content",
      "layout": "title-only",
      "label": "Studio Proof",
      "ariaLabel": "A real workspace not a render export",
      "title": ["A Real Workspace, Not a Render Export"],
      "subtitle": "Reorder slides, edit notes, inspect layouts, queue Agent changes, and present from one document",
      "notes": "Narrative role: Prove that the workflow exists in the product\nEvidence: Live CadenzaSlide Studio capture"
    },
    "cross-content-proof": {
      "id": "cross-content-proof",
      "role": "content",
      "layout": "title-only",
      "label": "Cross-content Proof",
      "ariaLabel": "One system supports different narrative shapes",
      "title": ["One System, Different Narrative Shapes"],
      "subtitle": "Summaries, comparisons, steps, people, systems, quotations, and media share the same contracts",
      "notes": "Narrative role: Demonstrate reuse beyond one polished demo\nEvidence: Composition evaluation corpus"
    },
    "open-source": {
      "id": "open-source",
      "role": "content",
      "layout": "title-only",
      "label": "Open Source",
      "ariaLabel": "Inspectable by design",
      "title": ["Inspectable by Design"],
      "subtitle": "The Skill, JSON document, component contracts, renderer, and verifier can all be audited and extended",
      "notes": "Narrative role: Connect the architecture to the open-source proposition\nEvidence: Public repository structure and MIT license"
    },
    "closing": {
      "id": "closing",
      "role": "content",
      "layout": "statement",
      "label": "Closing",
      "ariaLabel": "Start with intent and end with evidence",
      "title": ["Start With Intent / End With Evidence"],
      "subtitle": "Create presentations that are not only beautiful, but explainable and verifiable",
      "notes": "Narrative role: Close with the product promise and call to action\nEvidence: Cadenza CLI and GitHub repository"
    }
  },
