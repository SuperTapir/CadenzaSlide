{
  "name": "cadenzaslide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "cadenza": "dist-cli/cli/cadenza.js"
  },
  "files": [
    "dist",
    "dist-cli",
    "design-system",
    ".agents/skills/cadenza-presentations",
    "cadenza.schema.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "assets:build": "node scripts/build-visual-assets.mjs",
    "cadenza": "node --experimental-strip-types src/apps/cli/cadenza-bin.ts",
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.cli.config.ts",
    "prepack": "npm run build",
    "preview": "vite preview",
    "test": "vitest run --exclude='tests/e2e/**'",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@iconify-json/line-md": "1.2.16",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "lucide-static": "1.31.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "playwright": "^1.62.1",
    "reveal.js": "^6.0.1"
  },
  "description": "Local-first presentation runtime and agent authoring system",
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": []
}
